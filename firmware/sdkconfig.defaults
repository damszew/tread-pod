# Rust std on ESP-IDF needs a bigger main task stack than the C default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16000

# XIAO ESP32-S3: 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# BLE: NimBLE in both roles, the footpod (peripheral) and the treadmill client (central).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# The treadmill, plus one watch or phone on the footpod. Never two: a second watch would get
# another runner's speed, and config (phone) is only possible outside a workout. The limit is
# global, not per role; what keeps the footpod to one central is that it doesn't advertise while
# connected (see footpod.rs).
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
# NimBLE logs every GAP procedure at info, twice a second while scanning.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
